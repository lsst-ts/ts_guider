# Local development image for scripts/setup_guider_emulator_container.sh.
# This layer is optional once the base image gives saluser passwordless sudo.
ARG BASE_IMAGE=lsstts/develop-env:develop
FROM ${BASE_IMAGE}

USER root

# dnf and visudo need system libraries, not the inherited LSST library paths.
# Per-command assignments leave the image's original LD_LIBRARY_PATH intact.
RUN LD_LIBRARY_PATH=/lib64:/usr/lib64 /usr/bin/dnf install -y sudo && \
    LD_LIBRARY_PATH=/lib64:/usr/lib64 /usr/bin/dnf clean all && \
    mkdir -p /etc/sudoers.d && \
    printf 'saluser ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/90-guider-development && \
    chmod 0440 /etc/sudoers.d/90-guider-development && \
    LD_LIBRARY_PATH=/lib64:/usr/lib64 /usr/sbin/visudo -cf /etc/sudoers

USER saluser
