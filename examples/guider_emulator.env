# Copy to ~/guider_emulator.env and adjust these settings once per container.
# GUIDER_REPO is the checkout containing the helper; GUIDER_WORKSPACE is its parent.
CCSDAQ="$GUIDER_WORKSPACE/R5-V13.16"
GUIDER_XML="$GUIDER_WORKSPACE/ts_xml"
GUIDER_SALOBJ="$GUIDER_WORKSPACE/ts_salobj"
GUIDER_CSC_CONFIG="$GUIDER_REPO/examples/emulator_config"
GUIDER_INDEX=1

LSST_KAFKA_BROKER_ADDR=broker:29092
LSST_SCHEMA_REGISTRY_URL=http://schema-registry:8081
LSST_SITE=test
# Use a distinct name if another Guider is already running in this Kafka cluster.
LSST_TOPIC_SUBNAME=guider_local
